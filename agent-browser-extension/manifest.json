{
  "manifest_version": 3,
  "name": "AI Agent Chat",
  "version": "1.0.0",
  "description": "Выделите текст → ПКМ → отправьте в AI Agent",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs",
    "windows"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
